# Settings for the crypto book (Phase 6). Copy this file to .env.crypto in the repository root
# and fill in the paper keys of the account it will use. Never commit .env.crypto.
#
# Run it beside the stock book: set CRYPTO_ENV_FILE=../.env.crypto in .env, then `trader serve`
# shows a Crypto tab. Or on its own: trader --env-file ../.env.crypto serve --port 8003
#
# Only this file sets the crypto book: nothing from .env or the environment leaks in.
# Alpaca offers crypto only in some US states; check yours before you start.

ASSET_CLASS=crypto

# ------------------------------------------------------------------ where orders go
BROKER=alpaca
TRADING_MODE=paper
LIVE_TRADING_CONFIRMED=false
DRY_RUN=false
# Tags this book's orders (tpC-20261113-BTCUSD-buy) and its ledger rows
ACCOUNT_LABEL=C

# Paper keys of the account this book trades, not the stock account's
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ------------------------------------------------------------------ prices and storage
# alpaca = Alpaca's daily crypto bars (no keys needed for these); csv = a file of daily closes
DATA_SOURCE=alpaca
CSV_PATH=data/crypto_closes.csv
# Its own ledger. In Docker, sqlite:///./data/crypto.db keeps it in the app's data volume.
DATABASE_URL=sqlite:///./crypto.db
REPORTS_DIR=reports

# ------------------------------------------------------------------ strategy
STRATEGY=trend
UNIVERSE=BTC/USD,ETH/USD
BENCHMARK=BTC/USD
# The watchlist scanner is for stocks
WATCHLIST=

# ------------------------------------------------------------------ risk limits (percent of equity)
# The stop sits 15% below each buy and its limit 5% below the stop, so the worst fill loses
# 19.25%; with 1% at risk per trade, each coin gets at most about 5% of the account.
RISK_PER_TRADE_PCT=1.0
# 15% is the recommended stop. The dashboard (Your settings) can change it too, and its choice
# wins over this line; a stop wider than recommended shows its warnings and waits for your OK.
STOP_LOSS_PCT=15.0
STOP_LIMIT_BAND_PCT=5.0
MAX_POSITION_PCT=5.0
MAX_OPEN_POSITIONS=2
DAILY_LOSS_LIMIT_PCT=2.0
MAX_DRAWDOWN_PCT=10.0
MAX_ORDERS_PER_DAY=10
ENTRY_LIMIT_BUFFER_PCT=0.5
MAX_GAP_PCT=5.0
# Crypto never closes: orders still unfilled after this many minutes are canceled
ENTRY_TTL_MINUTES=60
AUTO_APPROVE=false

# Backtests: cost per side in basis points (Alpaca's 0.25% taker fee plus the spread)
COST_BPS=35

AI_MODE=off

# ------------------------------------------------------------------ Telegram (optional)
# The stock book's bot works here too: each button names its account.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------ API and scheduler
# These two count when this book runs on its own. Beside the stock book, the stock book's
# token protects both books and its ENABLE_SCHEDULER starts both schedules.
API_TOKEN=
# The 1:05 am and 1:15 am ET daily jobs, and the send and protect jobs every 5 minutes
ENABLE_SCHEDULER=true
TIMEZONE=America/New_York
