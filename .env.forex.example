# Settings for the forex book (Phase 7). Copy this file to .env.forex in the repository root and
# fill in your OANDA practice token and account ID. Never commit .env.forex.
#
# Alpaca doesn't trade currencies, so this book uses OANDA. Open a free practice account at
# oanda.com, then create a personal access token in its account settings ("Manage API Access").
#
# Run it beside the stock book: set FOREX_ENV_FILE=../.env.forex in .env, then `trader serve`
# shows a Forex tab. Or on its own: trader --env-file ../.env.forex serve --port 8004
#
# Only this file sets the forex book: nothing from .env or the environment leaks in.

ASSET_CLASS=forex

# ------------------------------------------------------------------ where orders go
# paper = OANDA's practice server; live needs LIVE_TRADING_CONFIRMED=true and a live token
BROKER=oanda
TRADING_MODE=paper
LIVE_TRADING_CONFIRMED=false
DRY_RUN=false
# Tags this book's orders (tpF-20261113-EURUSD-buy, or -short and -cover) and its ledger rows
ACCOUNT_LABEL=F

# A personal access token and the v20 account ID (it looks like 101-001-1234567-001)
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=

# ------------------------------------------------------------------ prices and storage
# oanda = OANDA's daily candles, closing at 5 pm New York (the token above reads them);
# csv = a file of daily closes
DATA_SOURCE=oanda
CSV_PATH=data/forex_closes.csv
# Its own ledger. In Docker, sqlite:///./data/forex.db keeps it in the app's data volume.
DATABASE_URL=sqlite:///./forex.db
REPORTS_DIR=reports

# ------------------------------------------------------------------ strategy
STRATEGY=trend
# The pairs: standard (the seven majors) or exotic (the dollar against the Mexican peso, South
# African rand, Polish zloty, Hungarian forint, Czech koruna and Singapore dollar). Each set
# brings its own stop, sizes and backtest costs (below). You can also switch sets on the
# dashboard (Forex tab, Your settings); the dashboard's choice wins over this file.
PAIR_SET=standard
# Off until you switch it on, here or on the dashboard. With it on, a pair that closes below its
# 200-day average is sold short: it gains if the pair keeps falling and loses if it rises, with
# its stop above the entry. Every short is fully paid for and still needs your approval.
ALLOW_SHORTS=false
# To trade your own list instead, set the pairs and the benchmark yourself. Each pair needs the
# US dollar on one side (EUR/USD or USD/MXN), so every size and loss is counted in dollars.
# UNIVERSE=EUR/USD,USD/JPY
# BENCHMARK=EUR/USD
# The watchlist scanner is for stocks
WATCHLIST=

# ------------------------------------------------------------------ risk limits (percent of equity)
RISK_PER_TRADE_PCT=1.0
DAILY_LOSS_LIMIT_PCT=2.0
MAX_DRAWDOWN_PCT=10.0
MAX_ORDERS_PER_DAY=10
AUTO_APPROVE=false
# The pair set sets the rest. Standard: a stop 3% from each entry, at most 14% of the account per
# pair and seven pairs (a full stop-out costs about 0.42%; seven pairs stay inside the account),
# limits 0.1% past the price, entries skipped after a 1% gap. Exotic: a 5% stop, 10% per pair, six
# pairs (about 0.5% per stop-out), a 0.3% buffer and a 2% gap. The book never borrows, though
# OANDA would lend up to 50 times the deposit. Uncomment a line to set it yourself. The stop can
# also be changed on the dashboard, which warns you first when it's wider than recommended.
# STOP_LOSS_PCT=3.0
# MAX_POSITION_PCT=14.0
# MAX_OPEN_POSITIONS=7
# ENTRY_LIMIT_BUFFER_PCT=0.1
# MAX_GAP_PCT=1.0

# Backtests: cost per side in basis points (the spread), and the overnight financing charged on
# what's held, long or short, in basis points a year. Real financing is the gap between the two
# currencies' interest rates plus OANDA's fee, and can be a credit; the pair set's figures are
# cautious stand-ins (standard 3 and 250, exotic 15 and 600).
# COST_BPS=3
# FINANCING_BPS_PER_YEAR=250

AI_MODE=off

# ------------------------------------------------------------------ Telegram (optional)
# The stock book's bot works here too: each button names its account.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------ API and scheduler
# These two count when this book runs on its own. Beside the stock book, the stock book's
# token protects every book and its ENABLE_SCHEDULER starts every schedule.
API_TOKEN=
# Weekdays, New York time: send at 9:50 am, check against OANDA at 5:05 pm, signals at 5:15 pm
ENABLE_SCHEDULER=true
TIMEZONE=America/New_York
